# GEMINI_API_KEY: Optional Gemini API key (only used if AI features are enabled).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Base URL where this app is running (used for PayMongo GCash redirects).
APP_URL="http://localhost:3000"

# ----------------------------------------------------------------------------
# Navicat / MySQL 8.0 or MariaDB Database Configuration (Server-Only)
# Import database/medex_mysql_schema.sql in Navicat first, then fill these in.
# ----------------------------------------------------------------------------
MYSQL_HOST="127.0.0.1"
MYSQL_PORT="3306"
MYSQL_USER="root"
MYSQL_PASSWORD=""
MYSQL_DATABASE="medex_olongapo"
MYSQL_SSL="false"

# Session signing secret (use a long random string in production)
SESSION_SECRET="change_me_to_a_long_random_secret_string"

# Optional: Auto-initialize admin@medex.ph password on first boot (min 8 chars).
# You can also set it securely in the app UI on first sign-in.
ADMIN_INITIAL_PASSWORD=""

# ----------------------------------------------------------------------------
# PayMongo GCash Gateway (Express Backend Server-Only Secrets)
# ----------------------------------------------------------------------------
PAYMONGO_SECRET_KEY="sk_test_YOUR_PAYMONGO_SECRET_KEY"
PAYMONGO_WEBHOOK_SECRET="whsk_YOUR_PAYMONGO_WEBHOOK_SECRET"
